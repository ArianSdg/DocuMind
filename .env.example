# Copy to .env and fill in. Never commit .env.

# --- App ---
APP_NAME=DocuMind
ENVIRONMENT=development

# --- LLM (local: ollama pull llama3.2) ---
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
FAST_LLM_MODEL=llama3.2
LLM_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434
# Groq instead: LLM_PROVIDER=groq LLM_MODEL=llama-3.3-70b-versatile FAST_LLM_MODEL=llama-3.1-8b-instant
GROQ_API_KEY=

# --- Storage ---
DATABASE_URL=postgresql+psycopg://documind:documind@localhost:5432/documind
